# ── Subpath configuration ───────────────────────────────────────
# Subpath where the app is mounted (e.g. /mystudy-planner)
APPLICATION_ROOT=/mystudy-planner

# ── Database connection (recommended for Coolify) ───────────────
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME

# ── OR use individual vars ───────────────────────────────────────
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_NAME=mystudy_planner

# Set DB_SSL=true only if your Postgres requires SSL (e.g. Supabase/RDS)
# For Coolify internal DB on the same Docker network, leave as false
DB_SSL=false

PORT=5000

# Generate a strong random secret — e.g. openssl rand -hex 64
JWT_SECRET=change_me_to_a_long_random_secret
